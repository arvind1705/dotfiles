{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "~/.gemini/**", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "~/.gemini/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/aruba/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "openwiki": {
        "type": "local",
        "command": ["openwiki", "mcp", "--host", "opencode"]
      }
    }
  }
}
