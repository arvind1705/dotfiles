{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "port": 49374,
    "hostname": "0.0.0.0"
  },
  "providers": {
    "sensenova": {
      "settings": {
        "baseURL": "https://token.sensenova.ai/v1"
      }
    }
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "~/.gemini/**", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "~/.gemini/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/aruba/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    }
  ]
}
