# Secrets / creds — never commit
.zsh/secrets.zsh
**/secrets.zsh
**/service.json
**/auth.json
**/*oauth-token*
**/*.pem
**/*.key
.ssh/
.aws/
.codex/
.commandcode/
.gemini/
.docker/
.env
.envrc

# Runtime / machine-specific — never commit
config/ghostty/auto/
config/zed/prompts/
config/raycast/node-compile-cache/
.local/share/opencode/
.opencode/node_modules/
.zsh_history
.zsh_sessions/
.zcompdump*
.DS_Store

# Python / editor noise (kept minimal)
__pycache__/
*.py[codz]
.venv/
