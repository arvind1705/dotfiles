# Cube semantic layer configuration
LAN_IP=192.168.0.172
CUBE_API_PORT=4000
CUBE_SQL_PORT=15432
CUBEJS_PG_SQL_PORT=15432
CUBEJS_SQL_USER=cube
CUBEJS_SQL_PASSWORD=generate_a_long_random_sql_password
CUBEJS_DEV_MODE=false
CUBEJS_API_SECRET=generate_a_long_random_secret
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=postgres
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=kg_mcp_db
CUBEJS_DB_USER=kg_mcp
CUBEJS_DB_PASS=kg_mcp_pass
CUBEJS_DB_SSL=false
CUBEJS_DB_MAX_POOL=4
# No pre-aggregations are currently defined; avoid an idle refresh worker.
CUBEJS_CACHE_AND_QUEUE_DRIVER=memory
CUBEJS_REFRESH_WORKER=false
