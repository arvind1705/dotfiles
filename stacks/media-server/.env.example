# Copy/adjust values here, then run ./setup.sh (it writes the real .env with
# values auto-detected from this machine). Don't edit .env by hand afterwards
# unless you know what you're changing.

# --- Storage ---------------------------------------------------------------
# Everything lives under this folder. qBittorrent downloads straight into
# library/movies (and library/tv); Jellyfin reads the same folders.
MEDIA_ROOT=/home/aravind/entertainment

# --- Network ---------------------------------------------------------------
# UIs bind ONLY to this LAN IP. Nothing is published on 0.0.0.0.
# Set a DHCP reservation for this IP on your router.
LAN_IP=192.168.0.172

JELLYFIN_PORT=8096
# 8080 on the host is taken by the Dgraph dev container -> use 8081.
# This value is used for BOTH the host and container WebUI port: qBittorrent
# 5.x rejects requests when the Host header port != its own WebUI port.
QBT_WEBUI_PORT=8081
# BitTorrent listen port; forward TCP+UDP on your router for better peers.
QBT_LISTEN_PORT=6881

# --- Ownership / locale ----------------------------------------------------
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Intel Quick Sync (/dev/dri) -------------------------------------------
# getent group render / getent group video
RENDER_GID=991
VIDEO_GID=44

# --- Web UI credentials ----------------------------------------------------
# Applied by set-credentials.sh to BOTH Jellyfin and qBittorrent.
# CHANGE THESE: the default below is a weak, date-like password and is stored
# in plain text (see the README security note). Quote values with spaces or
# shell metacharacters, e.g. MEDIA_PASSWORD='p@ss word'.
MEDIA_USER=aravind
MEDIA_PASSWORD=change_this_password
