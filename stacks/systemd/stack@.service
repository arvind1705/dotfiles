[Unit]
Description=Docker Compose Stack: %i
Documentation=https://github.com/arvind1705/dotfiles
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=aravind
Group=aravind
SupplementaryGroups=docker
WorkingDirectory=/home/aravind/dev/dotfiles/stacks/%i
Environment=HOME=/home/aravind
ExecStart=/usr/bin/docker compose up -d --wait --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
