# Langfuse Configuration Example
# Copy to langfuse.env and adjust secrets as needed.

NEXTAUTH_URL=http://langfuse.local
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
SALT=generate_with_openssl_rand_base64_32
# Generate 256-bit hex key with: openssl rand -hex 32
ENCRYPTION_KEY=generate_64_hex_chars_with_openssl_rand_hex_32

TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true

# Database Connections (aruba-devdeps)
DATABASE_URL=postgresql://kg_mcp:kg_mcp_pass@postgres:5432/langfuse
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:clickhouse@langfuse-clickhouse:9000/default
CLICKHOUSE_URL=http://clickhouse:clickhouse@langfuse-clickhouse:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_CLUSTER_ENABLED=false
CLICKHOUSE_CLUSTER_NAME=default
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Object Storage (MinIO)
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=miniosecret
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://langfuse-minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=miniosecret
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio.local:9092
LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT=http://langfuse-minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true

# Initial Admin User & Organization (created on first start)
LANGFUSE_INIT_ORG_ID=aruba
LANGFUSE_INIT_ORG_NAME=aruba
LANGFUSE_INIT_PROJECT_ID=aruba
LANGFUSE_INIT_PROJECT_NAME=aruba
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-init-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-init-key
LANGFUSE_INIT_USER_EMAIL=admin@devbox.local
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=change_this_admin_password
