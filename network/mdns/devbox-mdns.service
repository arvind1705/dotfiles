[Unit]
Description=Unified Devbox mDNS Service Publisher
After=network-online.target avahi-daemon.service
Requires=avahi-daemon.service

[Service]
Type=simple
ExecStart=/home/aravind/dev/dotfiles/network/mdns/devbox-mdns-publisher.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
